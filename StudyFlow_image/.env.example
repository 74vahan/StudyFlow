# StudyFlow — environment variables (example)
# Copy to .env.local and fill with your own values. NEVER commit real values.

# --- MySQL ---
# Connection string for your MySQL database.
# Local example: mysql://root:yourpassword@localhost:3306/studyflow
# Cloud (Aiven/Railway/PlanetScale) usually gives you a ready-made URL.
DATABASE_URL=mysql://user:password@localhost:3306/studyflow

# TLS for cloud MySQL (leave both empty for local plain-TCP MySQL):
#   Option A — provider gives a CA certificate (Aiven, DigitalOcean, …):
#     paste the PEM here, or base64 of it. The server cert is verified against it.
# DATABASE_CA_CERT=
#   Option B — provider's cert chains to a public CA (PlanetScale, some Railway):
#     just require TLS and verify against the system trust store.
# DATABASE_SSL=true
#
# Optional: per-instance pool size (default 5). Keep it small on serverless so a
# free-tier connection cap isn't exhausted.
# DATABASE_CONNECTION_LIMIT=5

# --- Auth session ---
# Secret used to sign session cookies (JWT, HS256). Must be long and random.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Teacher login ---
# bcrypt hash of the teacher's 6-digit PIN, base64-encoded (base64 avoids the '$'
# characters that .env expansion would otherwise mangle). The PIN is never stored.
# Generate it with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('123456',10)).toString('base64'))"
TEACHER_PIN_HASH_B64=

# --- AI (Claude API) ---
# Server-only. Used by the /api/ai/plan route. Never exposed to the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key

# StudyFlow — environment variables (example)
# Copy to .env.local and fill with your own values. NEVER commit real values.

# --- MySQL ---
# Connection string for your MySQL database.
# Local example: mysql://root:yourpassword@localhost:3306/studyflow
# Cloud (PlanetScale/Railway/Aiven) usually gives you a ready-made URL.
DATABASE_URL=mysql://user:password@localhost:3306/studyflow

# --- Auth session ---
# Secret used to sign session cookies (JWT, HS256). Must be long and random.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Teacher login ---
# bcrypt hash of the teacher's 6-digit PIN, base64-encoded (base64 avoids the '$'
# characters that .env expansion would otherwise mangle). The PIN is never stored.
# Generate it with:
#   node -e "console.log(Buffer.from(require('bcryptjs').hashSync('123456',10)).toString('base64'))"
TEACHER_PIN_HASH_B64=

# --- AI (Claude API) ---
# Server-only. Used by the /api/ai/plan route. Never exposed to the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key

{
  "name": "studyflow-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "StudyFlow monorepo — app in StudyFlow_image/, infrastructure in StudyFlow_infra/",
  "scripts": {
    "dev": "npm --prefix StudyFlow_image run dev",
    "build": "npm --prefix StudyFlow_image run build",
    "start": "npm --prefix StudyFlow_image run start",
    "lint": "npm --prefix StudyFlow_image run lint",
    "install:app": "npm --prefix StudyFlow_image install"
  }
}

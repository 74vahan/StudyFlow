# Monorepo root. App-specific ignores live in StudyFlow_image/.gitignore.

# dependencies (if any tooling runs at the root)
/node_modules

# agent skills library (reproducible from skills-lock.json via `npx skills add`)
/.agents

# env files anywhere (keep examples; never commit real secrets)
.env
.env.*
!.env.example

# misc
.DS_Store
*.pem
npm-debug.log*

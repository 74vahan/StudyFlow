# StudyFlow — environment variables (example)
# Copy to .env.local and fill with your own values. NEVER commit real values.

# --- Supabase ---
# Project URL and publishable/anon key are safe for the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Service role key is SECRET — server only. Do NOT prefix with NEXT_PUBLIC_.
# Only add it if a server task truly needs to bypass RLS. Leave empty otherwise.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (Claude API) ---
# Server-only. Used by the /api/ai/plan route. Never exposed to the browser.
ANTHROPIC_API_KEY=your-anthropic-api-key
